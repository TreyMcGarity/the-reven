# Raw source documents should stay local and not be versioned
/docs/raw/*
!/docs/raw/.gitkeep

# Local environment secrets
.env
.env.*
!.env.example

# Python caches and virtual envs
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environments
.venv/
venv/

# LLM local runtime artifacts
*.log
*.tmp

# Lore LLM local-only state
/lore-llm/.env
/lore-llm/.venv/
/lore-llm/.pytest_cache/
/lore-llm/__pycache__/

# Fine-tuning outputs and caches
/lore-llm/finetune/artifacts/
/lore-llm/finetune/data/*.tmp
/lore-llm/finetune/data/*.cache
/lore-llm/finetune/data/*.bak
