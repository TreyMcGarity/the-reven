t"/><w:b w:val="1"/><w:bCs w:val="1"/><w:sz w:val="30"/><w:szCs w:val="30"/></w:rPr><w:drawing><wp:inline distB="114300" distT="114300" distL="114300" distR="114300"><wp:extent cx="1319611" cy="1423988"/><wp:effectExtent b="0" l="0" r="0" t="0"/><wp:docPr id="1" name="image1.png"/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="0" name="image1.png"/><pic:cNvPicPr preferRelativeResize="0"/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId6"/><a:srcRect b="0" l="0" r="0" t="0"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="1319611" cy="1423988"/></a:xfrm><a:prstGeom prst="rect"/><a:ln/></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Caveat" w:cs="Caveat" w:eastAsia="Caveat" w:hAnsi="Caveat"/><w:b w:val="1"/><w:bCs w:val="1"/><w:sz w:val="54"/><w:szCs w:val="54"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Amatic SC" w:cs="Amatic SC" w:eastAsia="Amatic SC" w:hAnsi="Amatic SC"/><w:b w:val="1"/><w:bCs w:val="1"/><w:sz w:val="246"/><w:szCs w:val="246"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">The Reven</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000002"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:b w:val="1"/><w:bCs w:val="1"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">ACT 0</w:t><w:br w:type="textWrapping"/></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> 2053TA. Valna, a young woman in Vikren, watches ADMIN forces occupy her town. A whisper draws her to the roof's edge; she falls, blacks out. Wakes hours later with unexplained bandaging and a growing sense of presence — the first trace of the Revenant Stone reaching for her.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000003"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:b w:val="1"/><w:bCs w:val="1"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">ACT I — Personal Hell</w:t><w:br w:type="textWrapping"/></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> Nightmares and waking visions escalate; friends and family notice her shift. Doctors find her vitals abnormal. She attempts suicide multiple times, each time waking healed, with fragments of memory that aren't hers (Khathrey's). Her family, believing her mentally ill, commits her to a remote facility.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000004"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Inside, she learns the facility is really an ADMIN detention site for MAP individuals. Her abilities awaken further; she breaks out during a mage assault on the site. Outside, Dae intercepts her and explains the truth: she's carrying Khathrey, whose soul (and the demon she absorbed fighting Genak) has been sealed in the Revenant Stone since the cave battle. Dae recovered the Stone and has been searching for a vessel capable of bearing it — Valna, unknowingly, already is one; the fall in Act 0 is when the Stone first bonded to her.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000005"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">She doesn’t fully believe him but has no better explanation. She leaves with Dae.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000006"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">ACT II — Revolt / Awakening</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000007"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Dae shelters her in a safehouse, training her by day. At night, the bond deepens — the demon within the Stone manifests as nightmare-trials, forcing her to best fragments of it one by one. Final confrontation: the demon takes Genak’s remnant form and fully engages her. She barely wins. It shifts once more into Khathrey herself, who tells her the trial is complete — Valna has mastered the minions and herself, and Khathrey’s power, memory, and identity now fully merge into her.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000008"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">She wakes as Valnarey — new bearing, new clothes and staff (Khathrey’s) fit her perfectly. Dae introduces her to the gathered coalition of mages and technologists preparing the final offensive against ADMIN.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000009"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">ACT III — Battle Against R</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000A"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">The coalition learns ADMIN’s true master is R, the spirit that has puppeted the organization since before Genak’s fall — Genak was a lieutenant; R is the source. ADMIN’s scientists have built a magic-draining weapon (the Ray) that incapacitates mages on contact. The coalition must breach ADMIN defenses, destroy the Ray, and confront R’s manifestation directly.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000B"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Valnarey leads the assault alongside Dae. Grueling battle; she defeats R. Dae simultaneously dismantles ADMIN’s command structure. With R gone and ADMIN broken, the ruling powers pass a new law: the prohibition on magic ends. Magic and science become legally and culturally integrated.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000C"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Closing</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000D"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Dae, now serving as a leading civil authority over the region, begins integrating magic and technology at scale — reversing the Ray’s effects to restore (and even grant) abilities to those who lost them, and moving to rebuild the College of Magic.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000E"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">He tells Valnarey this is only one pillar down — R and Genak were local. He reveals intelligence on a hidden Dredth fortress near the Isle of Thunrow, led by a powerful draid, Hexrad — another pillar of the greater Empire behind Umbra. They depart for Thunrow, setting up Book 3’s opening front (the Thunrow bombardment sequence from your draft can open Book 3 or close Book 2 — your call on where the seam falls).</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000F"><w:pPr><w:rPr/></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:sectPr><w:pgSz w:h="15840" w:w="12240" w:orient="portrait"/><w:pgMar w:bottom="1440" w:top="1440" w:left="1440" w:right="1440" w:header="720" w:footer="720"/><w:pgNumType w:start="1"/></w:sectPr></w:body></w:document>